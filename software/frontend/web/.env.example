# Copy to `.env` and adjust. Restart `npm start` after edits.

# Dev server port (optional; default 3000).
PORT=3001
# Webpack dev server websocket port when behind a proxy or custom port.
WDS_SOCKET_PORT=3001

# Backend API base URL (no trailing slash).
# Production API used by release web and Android builds.
REACT_APP_API_URL=https://spectroniot.xyz
# For local backend work only, put this in an untracked `.env.local` file:
# REACT_APP_API_URL=http://localhost:8081

# Map tiles for the Add Farm location picker. Put provider keys in your local .env only.
REACT_APP_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional: mock hardware pairing when developing without devices (set to "true" to enable).
# REACT_APP_MOCK_MODE=false
# REACT_APP_HARDWARE_MOCK=false
# REACT_APP_MOCK_HARDWARE=false
